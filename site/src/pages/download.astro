---
import Base from "../layouts/Base.astro";
import Flower from "../components/Flower.astro";
import GetDaisy from "../components/GetDaisy.astro";
import { href, releaseAsset, repo, version } from "../config";
---

<Base title="Download" description={`Download Daisy ${version} for macOS.`}>
  <div class="wrap page">
    <header class="page-head">
      <Flower size={64} />
      <h1>Download Daisy</h1>
      <p>Version {version}. Signed with Developer ID and notarized by Apple.</p>
    </header>
    <p>Updating to 0.6.0? Update every member of your group. Earlier versions cannot connect to 0.6.0; your paired identities and trust settings are retained.</p>
    <div class="download-panel">
      <div class="verify">
        <GetDaisy />
        <p class="download-meta dl-only">{releaseAsset} · Apple silicon</p>
        <p class="dl-only">The download starts right away. Install it on every system you want to share.</p>
        <h2 class="section-sub">Install</h2>
        <ol class="steps">
          <li><div><h3>Open the DMG</h3><p>It opens from Downloads.</p></div></li>
          <li><div><h3>Drag Daisy to Applications</h3><p>Then open it. Daisy appears in the menu bar.</p></div></li>
          <li><div><h3>Follow Daisy's setup</h3><p>Allow Accessibility and Input Monitoring, then pair. <a href={href("/docs/getting-started/")}>Getting started</a> walks through it.</p></div></li>
        </ol>
        <h2 class="section-sub">Homebrew</h2>
        <p>Each release includes a Homebrew cask for the same signed and notarized app. <a href={href("/docs/user-guide/#homebrew")}>Create a local tap, install, and upgrade</a>. Accessibility and Input Monitoring still need approval in System Settings.</p>
      </div>
      <div>
        <h2 class="section-sub">Requirements</h2>
        <dl class="spec-list">
          <dt>Hardware</dt><dd>Apple silicon</dd>
          <dt>macOS</dt><dd>26 or later</dd>
          <dt>Swipes</dt><dd>macOS 26 or later</dd>
          <dt>Network</dt><dd>Same network, wired or Wi-Fi</dd>
          <dt>Account</dt><dd>None</dd>
        </dl>
      </div>
    </div>

    <section class="section" id="verify" aria-labelledby="verify-title">
      <div class="section-head">
        <h2 id="verify-title">Verify your download</h2>
        <p>Every release is built by GitHub Actions from a tagged commit, with SLSA Build Level 3 provenance and a GitHub artifact attestation. Either check proves the download came from this project's release workflow.</p>
      </div>
      <div class="security">
        <div class="verify">
          <div class="verify-head"><h3>With the GitHub CLI</h3><button class="copy" type="button" data-copy>Copy</button></div>
          <pre class="code"><code>gh attestation verify {releaseAsset} \
  --repo misfitdev/daisy</code></pre>
        </div>
        <div class="verify">
          <div class="verify-head"><h3>With slsa-verifier</h3><button class="copy" type="button" data-copy>Copy</button></div>
          <pre class="code"><code>slsa-verifier verify-artifact {releaseAsset} \
  --provenance-path {releaseAsset}.intoto.jsonl \
  --source-uri github.com/misfitdev/daisy \
  --source-tag v{version}</code></pre>
        </div>
      </div>
      <p class="text-links"><a href={href("/docs/releasing/")}>How releases are built</a><a href={`${repo}/releases`}>All releases</a></p>
    </section>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const code = button.closest(".verify")?.querySelector("pre code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  .verify-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .copy {
    font: inherit;
    font-size: var(--step-small);
    min-height: 2rem;
    padding: 0.2rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .copy:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }
  .section-sub {
    font-size: var(--step-title);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .download-panel > div > .section-sub:first-child {
    margin-top: 0;
  }
  .download-panel .btn {
    justify-self: start;
  }
  .verify .download-meta {
    margin-top: -0.5rem;
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
  }
  .page .section {
    padding-bottom: 0;
    margin-top: var(--space-5);
  }
</style>
