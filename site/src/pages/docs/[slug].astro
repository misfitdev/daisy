---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { docs } from "../../lib/docs.mjs";

export async function getStaticPaths() {
  const entries = [...await getCollection("docs"), ...await getCollection("contributors")];
  return docs.map((d) => ({
    params: { slug: d.slug },
    props: { entry: entries.find((e) => e.id.toLowerCase() === d.file.toLowerCase())!, meta: d },
  }));
}

const { entry, meta } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
---

<Docs title={meta.title} slug={meta.slug} lede={meta.lede} description={meta.lede} sections={sections.length >= 6 ? sections : undefined}>
  <Content />
</Docs>
