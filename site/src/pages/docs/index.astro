---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
const entries = await getCollection("docs");
const entry = entries.find((entry) => entry.id.toLowerCase() === "readme")!;
const { Content } = await render(entry);
---
<Base title="Docs" current="docs" description="Find setup, daily tasks, troubleshooting and technical reference for Daisy.">
  <div class="wrap page">
    <header class="page-head"><h1>Docs</h1></header>
    <div class="prose"><Content /></div>
  </div>
</Base>
