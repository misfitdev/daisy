---
import Base from "../layouts/Base.astro";
import Desk from "../components/Desk.astro";
import Flower from "../components/Flower.astro";
import GetDaisy from "../components/GetDaisy.astro";
import SetupLoop from "../components/SetupLoop.astro";
import { features } from "../lib/status";
import { chain, colors, flower } from "../lib/marks";
import { href, repo } from "../config";

// Flowers sit over the center of each equal column; the SVG scales uniformly with the row.
const nodes = [0, 1, 2].map((k) => ({ x: ((k * 2 + 1) * 1240) / 6, y: 40 }));
const movesSvg =
  chain(nodes[0], nodes[1]).join("") +
  chain(nodes[1], nodes[2]).join("") +
  nodes.map((n) => `<g transform="translate(${n.x} ${n.y}) scale(1.1)">${flower(colors.yellow)}</g>`).join("");
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-row">
        <h1 id="hero-title"><span class="hero-line">One keyboard</span> <span class="hero-line">One trackpad</span> <span class="coral-mark">Every screen</span></h1>
        <div class="hero-action">
          <p class="hero-lede">Daisy shares one keyboard, mouse and trackpad across up to eight systems on the same network. No Apple ID, no iCloud, no account.</p>
          <GetDaisy />
          <p class="hero-meta">Free and open source · macOS 26 or later</p>
        </div>
      </div>
    </div>
    <Desk />
  </section>

  <div class="thread" data-thread>
  <section class="section" aria-labelledby="native-title">
    <div class="wrap">
      <span class="thread-node" data-thread-node aria-hidden="true"><Flower size={60} state="disconnected" /></span>
      <div class="section-head">
        <h2 id="native-title">Gestures everywhere</h2>
      </div>
      <div class="native-points">
        <div>
          <h3>macOS-native</h3>
          <p>Swipe between Spaces, open Mission Control or App Exposé on any screen. Trackpad gestures work from macOS 26 and later.</p>
        </div>
        <div>
          <h3>Your hands decide</h3>
          <p>There is no main system. Use the keyboard or trackpad in front of you and that system takes control at once.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="setup-title">
    <div class="wrap">
      <span class="thread-node" data-thread-node aria-hidden="true"><Flower size={60} state="disconnected" /></span>
      <div class="section-head">
        <h2 id="setup-title">Three moves</h2>
      </div>
      <svg class="moves-chain" viewBox="0 0 1240 80" aria-hidden="true" set:html={movesSvg} />
      <div class="moves" data-moves>
        <div class="move">
          <div class="move-node"><Flower size={56} /></div>
          <h3>Install</h3>
          <p>Download and install like any other app.</p>
        </div>
        <div class="move">
          <div class="move-node"><Flower size={56} /></div>
          <h3>Allow</h3>
          <p>Grant Daisy permission to read and replay input.</p>
        </div>
        <div class="move">
          <div class="move-node"><Flower size={56} /></div>
          <h3>Pair</h3>
          <p>Start sharing and follow the prompts.</p>
        </div>
      </div>
      <SetupLoop />
      <p class="text-links"><a href={href("/docs/getting-started/")}>Read the full getting-started guide</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="security-title">
    <div class="wrap">
      <span class="thread-node" data-thread-node aria-hidden="true"><Flower size={60} state="disconnected" /></span>
      <div class="section-head">
        <h2 id="security-title">Input stays private</h2>
        <p>Encrypted, direct and never recorded. <a href={href("/security/")}>How Daisy keeps it that way</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="status-title">
    <div class="wrap">
      <span class="thread-node" data-thread-node aria-hidden="true"><Flower size={60} state="disconnected" /></span>
      <div class="section-head">
        <h2 id="status-title">Features</h2>
      </div>
      <ul class="features" style={`--rows: ${Math.ceil(features.length / 2)}`}>
        {features.map((f) => {
          const available = f.status === "available";
          return (
          <li class:list={[{ "is-off": !available }]}>
            <Flower size={30} state={available ? "connected" : "disconnected"} />
            <div>
              <strong>{f.title}</strong>
              <span>{f.detail}</span>
            </div>
            {!available && <em>Planned</em>}
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="closing-title">
    <div class="wrap closing">
      <span class="thread-node" data-thread-node aria-hidden="true"><Flower size={60} state="disconnected" /></span>
      <h2 id="closing-title">Every system, one desk</h2>
      <div class="closing-actions">
        <GetDaisy />
        <a class="btn btn-ghost" href={repo}>View on GitHub</a>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  import { chainAlong } from "../lib/marks";

  const thread = document.querySelector<HTMLElement>("[data-thread]")!;
  const wide = matchMedia("(min-width: 1100px)");
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  let svg: SVGSVGElement | null = null;
  let links: SVGGElement[] = [];
  let flowers: HTMLElement[] = [];
  let queued = false;

  const centerOf = (el: Element, origin: DOMRect) => {
    const r = el.getBoundingClientRect();
    return { x: r.left - origin.left + r.width / 2, y: r.top - origin.top + r.height / 2 };
  };

  /** Lay one chain from flower to flower down the rail. */
  function build() {
    svg?.remove();
    svg = null;
    links = [];
    flowers = [...thread.querySelectorAll<HTMLElement>("[data-thread-node]")];
    if (!wide.matches) {
      update();
      return;
    }
    const origin = thread.getBoundingClientRect();
    const points = flowers.map((f) => centerOf(f, origin));
    let markup = "";
    for (let i = 0; i < points.length - 1; i++) {
      const a = points[i];
      const b = points[i + 1];
      markup += chainAlong([a, b], 40).join("");
    }
    const ns = "http://www.w3.org/2000/svg";
    svg = document.createElementNS(ns, "svg");
    svg.classList.add("thread-svg");
    svg.setAttribute("width", String(origin.width));
    svg.setAttribute("height", String(origin.height));
    svg.setAttribute("aria-hidden", "true");
    svg.innerHTML = markup;
    thread.prepend(svg);
    links = [...svg.querySelectorAll<SVGGElement>(".link")];
    update();
  }

  /** Links arrive as they scroll into view; each flower lights once the chain reaches it. */
  function update() {
    queued = false;
    const reach = innerHeight * 0.82;
    if (calm.matches) {
      links.forEach((l) => l.classList.add("is-in"));
      flowers.forEach((f) => f.classList.add("is-on"));
      return;
    }
    let lastIn = -Infinity;
    for (const l of links) {
      const top = l.getBoundingClientRect().top;
      const on = top < reach;
      l.classList.toggle("is-in", on);
      if (on) lastIn = Math.max(lastIn, top);
    }
    for (const f of flowers) {
      const r = f.getBoundingClientRect();
      f.classList.toggle("is-on", r.top + r.height / 2 < reach && (links.length === 0 || lastIn >= r.top - 60));
    }
  }

  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };

  addEventListener("scroll", schedule, { passive: true });
  new ResizeObserver(() => build()).observe(thread);
  wide.addEventListener("change", build);
  document.fonts?.ready.then(build);
  build();

  // Light the move whose scene is playing in the setup loop; moves after it wait gray.
  const moves = document.querySelector<HTMLElement>("[data-moves]")!;
  const steps = [...moves.querySelectorAll<HTMLElement>(".move")];
  const stepFlowers = [...document.querySelectorAll<SVGGElement>(".moves-chain .flower")];
  addEventListener("setupstep", (e) => {
    const at = (e as CustomEvent<number | null>).detail;
    moves.classList.toggle("is-playing", at !== null);
    [steps, stepFlowers].forEach((list) =>
      list.forEach((el, i) => {
        el.classList.toggle("is-current", at === i);
        el.classList.toggle("is-ahead", at !== null && i > at);
      }),
    );
  });
</script>
