---
import Base from "./Base.astro";
import { docs } from "../lib/docs.mjs";
import { href } from "../config";

interface Props {
  title: string;
  description?: string;
  slug: string;
  lede?: string;
  sections?: { slug: string; text: string }[];
}
const { title, description, slug, lede, sections } = Astro.props;
const guides = [
  { slug: "getting-started", title: "Getting started", group: "Use" },
  { slug: "trust", title: "Trust and pairing", group: "Use" },
];
const all = [...guides, ...docs];
const groups = ["Use", "Understand", "Contribute"].map((g) => ({ name: g, items: all.filter((d) => d.group === g) }));
---

<Base title={title} description={description} current="docs">
  <div class="wrap page docs-layout">
    <nav class="docs-nav" aria-label="Documentation">
      {groups.map((g) => (
        <>
          <h2>{g.name}</h2>
          <ul>
            {g.items.map((d) => (
              <li><a href={href(`/docs/${d.slug}/`)} aria-current={d.slug === slug ? "page" : undefined}>{d.title}</a></li>
            ))}
          </ul>
        </>
      ))}
    </nav>
    <article>
      <header class="page-head">
        <h1>{title}</h1>
        {lede && <p>{lede}</p>}
      </header>
      <details class="docs-nav-compact">
        <summary>{sections ? "Contents" : "All docs"}</summary>
        {sections && (
          <>
            <h2>On this page</h2>
            <ul>
              {sections.map((s) => (
                <li><a href={`#${s.slug}`}>{s.text}</a></li>
              ))}
            </ul>
            <h2>All docs</h2>
          </>
        )}
        <ul>
          {all.map((d) => (
            <li><a href={href(`/docs/${d.slug}/`)} aria-current={d.slug === slug ? "page" : undefined}>{d.title}</a></li>
          ))}
        </ul>
      </details>
      {sections && (
        <nav class="toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {sections.map((s) => (
              <li><a href={`#${s.slug}`}>{s.text}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <div class="prose">
        <slot />
      </div>
      {sections && <p class="back-top"><a href="#main">Back to top</a></p>}
    </article>
  </div>
</Base>
