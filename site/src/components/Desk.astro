---
import { initialState, renderDesk } from "../lib/desk";

const svg = renderDesk(initialState(), { pointer: false });
---

<section class="desk" data-desk aria-label="Try Daisy: a virtual desk of systems">
  <div class="desk-bar">
    <div class="desk-read">
      <p class="desk-hint" data-hint>Push the pointer through the right edge of this system.</p>
      <p class="desk-status" role="status" aria-live="polite" data-status>This system has control.</p>
    </div>
    <div class="desk-controls">
      <button type="button" class="desk-btn" data-action="arrange" aria-pressed="false">Arrange displays</button>
      <button type="button" class="desk-btn" data-action="swipe">Swipe to next Space</button>
      <button type="button" class="desk-btn" data-action="connect" aria-pressed="true">Disconnect</button>
      <button type="button" class="desk-btn" data-action="add">Add a system</button>
      <button type="button" class="desk-btn desk-btn-quiet" data-action="reset">Reset</button>
    </div>
  </div>
  <div class="desk-stage" data-stage set:html={svg} />
  <p class="desk-keys"><kbd>Esc</kbd> takes control back, standing in for <kbd>Control</kbd>-<kbd>Option</kbd>-<kbd>Command</kbd>-<kbd>Escape</kbd>. Typing goes to the system with control.</p>
  <p class="desk-fallback">
    <span class="fallback-small">Open this page on a computer with a mouse or trackpad to drive the desk yourself.</span>
    <span class="fallback-motion">The interactive desk is paused because reduced motion is on.</span>
  </p>
</section>

<script>
  import {
    addScreen,
    adjacentPairs,
    bounds,
    center,
    homeSides,
    initialState,
    interior,
    reclaim,
    renderDesk,
    snap,
    snapCandidate,
    step,
    SPACES,
    type DeskState,
    type Screen,
    type Side,
  } from "../lib/desk";
  import { drawRope, makeRope, motion, stepRope, tug, type Rope } from "../lib/rope";

  const root = document.querySelector<HTMLElement>("[data-desk]")!;
  const stage = root.querySelector<HTMLElement>("[data-stage]")!;
  const hint = root.querySelector<HTMLElement>("[data-hint]")!;
  const status = root.querySelector<HTMLElement>("[data-status]")!;
  const live = matchMedia("(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)");

  type Vec = { x: number; y: number };
  type Body = { x: number; y: number; vx: number; vy: number };
  type Box = { x: number; y: number; w: number; h: number };

  // Display springs: slightly underdamped so a dropped display settles with a small overshoot.
  const STIFFNESS = 340;
  const DAMPING_RATIO = 0.7;
  const MAGNET = 56;

  let state: DeskState = initialState();
  let svg: SVGSVGElement;
  let held = false;
  let engaged = false;
  // Virtual pointer = real pointer + offset. The offset changes only when control
  // crosses, so the two never drift apart between crossings.
  let offset: Vec = { x: 0, y: 0 };
  let lastReal: Vec | null = null;
  let swiping = false;
  let wheel = 0;
  let wheelTimer = 0;
  let drag: { id: string; grab: Vec; origin: Vec; target: Vec } | null = null;
  let started = false;

  const bodies = new Map<string, Body>();
  let ropes = new Map<string, Rope>();
  let view: Box | null = null;
  let running = false;
  let calm = 0;

  const name = (id: string) => state.screens.find((s) => s.id === id)?.label ?? "This system";
  const byId = (id: string) => state.screens.find((s) => s.id === id)!;

  function body(s: Screen): Body {
    let b = bodies.get(s.id);
    if (!b) {
      b = { x: s.x, y: s.y, vx: 0, vy: 0 };
      bodies.set(s.id, b);
    }
    return b;
  }

  /** Where a screen is drawn: its body, which springs toward the screen's logical place. */
  function shift(s: Screen): Vec {
    const b = body(s);
    return { x: b.x - s.x, y: b.y - s.y };
  }

  function drawnCenter(s: Screen): Vec {
    const c = center(s);
    const d = shift(s);
    return { x: c.x + d.x, y: c.y + d.y };
  }

  function syncRopes(dropIn: boolean) {
    const next = new Map<string, Rope>();
    if (state.connected) {
      for (const { key, a, b } of adjacentPairs(state)) {
        next.set(key, ropes.get(key) ?? makeRope(key, a.id, b.id, drawnCenter(a), drawnCenter(b), dropIn ? 70 : 0));
      }
    }
    ropes = next;
  }

  function render() {
    stage.innerHTML = renderDesk(state, { liveChains: true });
    svg = stage.querySelector("svg")!;
    for (const id of [...bodies.keys()]) if (!state.screens.some((s) => s.id === id)) bodies.delete(id);
    const target = bounds(state);
    if (!view || drag) view = view ?? target;
    root.classList.toggle("is-arranging", state.arranging);
    updateHint();
    paint();
    wake();
  }

  function paint() {
    if (view) svg.setAttribute("viewBox", `${view.x} ${view.y} ${view.w} ${view.h}`);
    for (const s of state.screens) {
      const d = shift(s);
      svg.querySelector(`.screen[data-id="${s.id}"]`)?.setAttribute("transform", `translate(${d.x} ${d.y})`);
      const c = drawnCenter(s);
      svg.querySelector(`.flower-at[data-id="${s.id}"]`)?.setAttribute("transform", `translate(${c.x} ${c.y})`);
      svg.querySelectorAll(`[data-follow="${s.id}"]`).forEach((g) => g.setAttribute("transform", `translate(${d.x} ${d.y})`));
    }
    const layer = svg.querySelector(".chains-live");
    if (layer) layer.innerHTML = [...ropes.values()].map(drawRope).join("");
    const pointer = svg.querySelector(".pointer");
    if (pointer) {
      const d = shift(byId(state.active));
      pointer.setAttribute("transform", `translate(${state.pointer.x + d.x} ${state.pointer.y + d.y})`);
    }
  }

  function tick() {
    let moving = 0;
    const c = 2 * Math.sqrt(STIFFNESS) * DAMPING_RATIO;
    const dt = 1 / 60;
    for (const s of state.screens) {
      const b = body(s);
      const goal = drag && drag.id === s.id ? drag.target : { x: s.x, y: s.y };
      const ax = STIFFNESS * (goal.x - b.x) - c * b.vx;
      const ay = STIFFNESS * (goal.y - b.y) - c * b.vy;
      b.vx += ax * dt;
      b.vy += ay * dt;
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      moving = Math.max(moving, Math.abs(b.vx) * dt + Math.abs(b.vy) * dt, Math.abs(goal.x - b.x) + Math.abs(goal.y - b.y));
    }
    for (const [key, rope] of ropes) {
      const next = stepRope(rope, drawnCenter(byId(rope.a)), drawnCenter(byId(rope.b)));
      ropes.set(key, next);
      moving = Math.max(moving, motion(next));
    }
    if (view) {
      // While dragging, frame the display where it is drawn so it never leaves the stage.
      const t = drag
        ? bounds({ ...state, screens: state.screens.map((s) => (s.id === drag!.id ? { ...s, x: body(s).x, y: body(s).y } : s)) })
        : bounds(state);
      const k = 0.16;
      view = { x: view.x + (t.x - view.x) * k, y: view.y + (t.y - view.y) * k, w: view.w + (t.w - view.w) * k, h: view.h + (t.h - view.h) * k };
      moving = Math.max(moving, Math.abs(t.w - view.w) + Math.abs(t.x - view.x) + Math.abs(t.y - view.y) + Math.abs(t.h - view.h));
    }
    paint();
    calm = moving < 0.03 ? calm + 1 : 0;
    if (calm > 30 && !drag) {
      running = false;
      return;
    }
    requestAnimationFrame(tick);
  }

  function wake() {
    calm = 0;
    if (running) return;
    running = true;
    requestAnimationFrame(tick);
  }

  function say(text: string) {
    status.textContent = text;
  }

  function controlStatus() {
    if (!state.connected) return "Disconnected. Input stays on this system.";
    if (state.active === state.home) return "This system has control.";
    return `${name(state.active)} has control. Press Esc to take it back.`;
  }

  function updateHint() {
    if (state.arranging) {
      hint.textContent = "Drag a display to any edge of another. It snaps into place.";
      return;
    }
    if (!state.connected) {
      hint.textContent = "Connect again to share the keyboard and trackpad.";
      return;
    }
    const sides = homeSides(state);
    const words: Record<Side, string> = { left: "left", right: "right", above: "top", below: "bottom" };
    hint.textContent =
      sides.length === 1
        ? `Push the pointer through the ${words[sides[0]]} edge of this system.`
        : "Push the pointer through any edge with a peer beyond it.";
  }

  function toSvg(e: PointerEvent): Vec {
    const m = svg.getScreenCTM()!.inverse();
    const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m);
    return { x: p.x, y: p.y };
  }

  function bloom(id: string) {
    svg.querySelector<SVGGElement>(`.flower-at[data-id="${id}"] .petals`)?.animate(
      [{ transform: "scale(1) rotate(0deg)" }, { transform: "scale(1.09) rotate(8deg)" }, { transform: "scale(1) rotate(0deg)" }],
      { duration: 640, delay: 220, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
    );
  }

  function pull(from: string, to: string) {
    for (const rope of ropes.values()) {
      if ((rope.a === from && rope.b === to) || (rope.a === to && rope.b === from)) tug(rope, from);
    }
    bloom(to);
    wake();
  }

  function notice(side: Side) {
    const s = byId(state.active);
    const r = interior(s);
    const g = svg.querySelector<SVGGElement>(".notice")!;
    const x = side === "right" ? r.x + r.w - 150 : side === "left" ? r.x + 150 : state.pointer.x;
    const y = side === "below" ? r.y + r.h - 24 : side === "above" ? r.y + 40 : state.pointer.y - 24;
    g.innerHTML = `<rect x="${x - 128}" y="${y - 17}" width="256" height="30" rx="15" fill="#2E3235"/><text x="${x}" y="${y + 3}" text-anchor="middle">Release the button to cross</text>`;
    g.getAnimations().forEach((a) => a.cancel());
    g.animate([{ opacity: 1 }, { opacity: 1, offset: 0.7 }, { opacity: 0 }], { duration: 1400, fill: "forwards" });
    say("Control never crosses while a mouse button is held.");
  }

  function swipe(direction: 1 | -1) {
    if (swiping) return;
    swiping = true;
    const id = state.active;
    const w = interior(byId(id)).w;
    const out = svg.querySelector<SVGGElement>(`.screen[data-id="${id}"] .space-wrap`)!;
    const ease = "cubic-bezier(0.22, 1, 0.36, 1)";
    out.animate([{ transform: "translateX(0)" }, { transform: `translateX(${-direction * w}px)` }], { duration: 380, easing: ease, fill: "forwards" }).finished.then(() => {
      const current = state.space[id] ?? 0;
      state.space[id] = (current + direction + SPACES) % SPACES;
      render();
      const next = svg.querySelector<SVGGElement>(`.screen[data-id="${id}"] .space-wrap`)!;
      next.animate([{ transform: `translateX(${direction * w}px)` }, { transform: "translateX(0)" }], { duration: 420, easing: ease }).finished.then(() => {
        swiping = false;
      });
      say(`${name(id)} moved to Space ${state.space[id] + 1}.`);
    });
  }

  function onMove(e: PointerEvent) {
    if (drag) {
      const p = toSvg(e);
      const raw = { x: p.x - drag.grab.x, y: p.y - drag.grab.y };
      const slot = snapCandidate(state, drag.id, raw.x, raw.y);
      drag.target = slot && Math.hypot(slot.x - raw.x, slot.y - raw.y) < MAGNET ? slot : raw;
      wake();
      return;
    }
    if (state.arranging || swiping) return;
    const real = toSvg(e);
    lastReal = real;
    const want = { x: real.x + offset.x, y: real.y + offset.y };
    const result = step(state, want.x - state.pointer.x, want.y - state.pointer.y, held);
    if (result.kind === "crossed") {
      offset = { x: state.pointer.x - real.x, y: state.pointer.y - real.y };
      render();
      pull(result.from, result.to);
      say(controlStatus());
    } else if (result.kind === "blocked") {
      paint();
      notice(result.side);
    } else {
      paint();
    }
  }

  function onDown(e: PointerEvent) {
    held = true;
    if (!state.arranging) return;
    const target = (e.target as Element).closest<SVGGElement>(".screen");
    if (!target) return;
    const s = byId(target.dataset.id!);
    const b = body(s);
    const p = toSvg(e);
    drag = { id: s.id, grab: { x: p.x - b.x, y: p.y - b.y }, origin: { x: s.x, y: s.y }, target: { x: b.x, y: b.y } };
    stage.setPointerCapture(e.pointerId);
    root.classList.add("is-dragging");
    wake();
  }

  function onUp(e: PointerEvent) {
    held = false;
    if (!drag) return;
    const d = drag;
    drag = null;
    const ok = snap(state, d.id, d.target.x, d.target.y, d.origin);
    root.classList.remove("is-dragging");
    if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    syncRopes(true);
    render();
    say(ok ? `${name(d.id)} snapped into place.` : "That spot would overlap another display or cut a system off, so it went back.");
  }

  function onKey(e: KeyboardEvent) {
    if (!engaged || state.arranging) return;
    if (e.target instanceof Element && e.target.closest("button, a, input, textarea, select")) return;
    if (e.key === "Escape") {
      const from = reclaim(state);
      if (from) {
        offset = lastReal ? { x: state.pointer.x - lastReal.x, y: state.pointer.y - lastReal.y } : { x: 0, y: 0 };
        render();
        pull(from, state.home);
        say("Control is back on this system.");
      }
      return;
    }
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const key = `${state.active}:${state.space[state.active] ?? 0}`;
    if (e.key === "Backspace") {
      state.notes[key] = (state.notes[key] ?? "").slice(0, -1);
    } else if (e.key.length === 1) {
      state.notes[key] = ((state.notes[key] ?? "") + e.key).slice(-80);
    } else {
      return;
    }
    e.preventDefault();
    render();
  }

  function onWheel(e: WheelEvent) {
    if (state.arranging || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
    e.preventDefault();
    wheel += e.deltaX;
    clearTimeout(wheelTimer);
    wheelTimer = window.setTimeout(() => (wheel = 0), 220);
    if (Math.abs(wheel) > 90) {
      swipe(wheel > 0 ? 1 : -1);
      wheel = 0;
    }
  }

  function action(kind: string, button: HTMLButtonElement) {
    if (kind === "arrange") {
      state.arranging = !state.arranging;
      button.setAttribute("aria-pressed", String(state.arranging));
      button.textContent = state.arranging ? "Done arranging" : "Arrange displays";
      render();
      say(state.arranging ? "Arranging displays." : controlStatus());
    }
    if (kind === "swipe") swipe(1);
    if (kind === "connect") {
      state.connected = !state.connected;
      if (!state.connected && reclaim(state) && lastReal) {
        offset = { x: state.pointer.x - lastReal.x, y: state.pointer.y - lastReal.y };
      }
      button.setAttribute("aria-pressed", String(state.connected));
      button.textContent = state.connected ? "Disconnect" : "Connect";
      syncRopes(true);
      render();
      say(controlStatus());
    }
    if (kind === "add") {
      const s = addScreen(state);
      if (s) {
        const anchor = state.screens.find((o) => o !== s && adjacentPairs(state).some((p) => (p.a === s && p.b === o) || (p.b === s && p.a === o)));
        // The new display slides in from beyond the edge it joins.
        if (anchor) bodies.set(s.id, { x: s.x + (s.x - anchor.x) * 0.6, y: s.y + (s.y - anchor.y) * 0.6, vx: 0, vy: 0 });
        syncRopes(true);
        render();
        say("Added another system. It joins the group with one code.");
      }
      button.disabled = state.screens.length >= 4;
    }
    if (kind === "reset") {
      state = initialState();
      offset = { x: 0, y: 0 };
      bodies.clear();
      ropes = new Map();
      root.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((b) => (b.disabled = false));
      const arrange = root.querySelector<HTMLButtonElement>('[data-action="arrange"]')!;
      arrange.textContent = "Arrange displays";
      arrange.setAttribute("aria-pressed", "false");
      const connect = root.querySelector<HTMLButtonElement>('[data-action="connect"]')!;
      connect.textContent = "Disconnect";
      connect.setAttribute("aria-pressed", "true");
      syncRopes(true);
      render();
      say(controlStatus());
    }
  }

  function start() {
    if (started) return;
    started = true;
    root.classList.add("is-live");
    view = bounds(state);
    syncRopes(true);
    render();
    stage.addEventListener("pointermove", onMove);
    stage.addEventListener("pointerdown", onDown);
    stage.addEventListener("pointerup", onUp);
    stage.addEventListener("pointercancel", onUp);
    stage.addEventListener("pointerenter", () => {
      engaged = true;
      if (state.active === state.home) offset = { x: 0, y: 0 };
    });
    stage.addEventListener("pointerleave", () => {
      if (!drag) held = false;
      engaged = false;
    });
    document.addEventListener("pointerdown", (e) => {
      if (!stage.contains(e.target as Node)) engaged = false;
    });
    stage.addEventListener("wheel", onWheel, { passive: false });
    document.addEventListener("keydown", onKey);
    root.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((b) => b.addEventListener("click", () => action(b.dataset.action!, b)));
  }

  if (live.matches) start();
  live.addEventListener("change", () => live.matches && start());
</script>
