---
import { downloadUrl, version } from "../config";

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<a class:list={["btn", "dl-only", cls]} href={downloadUrl}>Download Daisy {version}</a>
<div class:list={["handoff", cls]}>
  <button class="btn" type="button" data-share>Send Daisy to your computer</button>
  <p class="handoff-note" data-share-status aria-live="polite">Daisy runs on macOS.</p>
</div>

<script>
  for (const share of document.querySelectorAll<HTMLButtonElement>("[data-share]")) {
    const status = share.parentElement?.querySelector<HTMLElement>("[data-share-status]");
    share.addEventListener("click", async () => {
      const url = location.href.split("#")[0];
      try {
        if (navigator.share) {
          await navigator.share({ title: "Daisy", text: "One keyboard, mouse and trackpad for every screen.", url });
          return;
        }
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = "Link copied. Open it on your computer to download.";
      } catch (error) {
        if ((error as DOMException).name === "AbortError") return;
        if (status) status.textContent = `Open ${url} on your computer to download.`;
      }
    });
  }
</script>
