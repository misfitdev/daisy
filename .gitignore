# macOS
.DS_Store
.swp

# Cargo
/target/

# Python packaging helpers
__pycache__/

# Beads databases and exports are local. The private DoltHub remote is the
# cross-clone source of truth.
.dolt/
*.db
.beads-credential-key
.beads.gate.lock
.beads/*
!.beads/README.md

# Agent and design-tool working state. Keep the durable Impeccable config,
# design tokens, and surface briefs; discard reviews, prompts, and local state.
.claude/
.codex/
.serena/
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/surfaces/
!.impeccable/surfaces/*.md

# Astro
/site/.astro/
/site/dist/
/site/node_modules/
